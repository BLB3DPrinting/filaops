      "PowerShell(gh run list *)",
      "PowerShell(python -m pytest *)",
      "PowerShell(pytest *)",
      "PowerShell(python -m unittest *)",
      "PowerShell(ruff *)",
      "PowerShell(rg *)",
      "PowerShell(gitleaks *)"
    ]
  }
}
