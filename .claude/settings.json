{
  "enabledPlugins": {},
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$HOME/.claude/hooks/trex-branch-guard.sh\""
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "powershell.exe -ExecutionPolicy Bypass -File \"$CLAUDE_PROJECT_DIR/.claude/hooks/run-tests.ps1\" \"$FILEPATH\""
          }
        ]
      }
    ]
  },
  "permissions": {
    "defaultMode": "default",
    "disableBypassPermissionsMode": "disable",
    "deny": [
      "Bash(gh pr merge *)",
      "Bash(gh pr review *)",
      "Bash(gh repo *)",
      "Bash(gh auth *)",
      "Bash(gh api -X *)",
      "Bash(gh api * -X *)",
      "Bash(gh api --method *)",
      "Bash(gh api * --method *)",
      "Bash(gh api -f *)",
      "Bash(gh api * -f *)",
      "Bash(gh api -F *)",
      "Bash(gh api * -F *)",
      "Bash(gh api --field *)",
      "Bash(gh api * --field *)",
      "Bash(gh api --raw-field *)",
      "Bash(gh api * --raw-field *)",
      "Bash(gh api --input *)",
      "Bash(gh api * --input *)",
      "Bash(git push --force *)",
      "Bash(git push * --force)",
      "Bash(git push * --force *)",
      "Bash(git push -f *)",
      "Bash(git push * -f)",
      "Bash(git push * -f *)",
      "Bash(git push * main)",
      "Bash(git push * main *)",
      "Bash(git push *:main)",
      "Bash(git push *:main *)",
      "Bash(git push * master)",
      "Bash(git push * master *)",
      "Bash(git push *:master)",
      "Bash(git push *:master *)",
      "Bash(git push *:refs/heads/main)",
      "Bash(git push *:refs/heads/main *)",
      "Bash(git push *:refs/heads/master)",
      "Bash(git push *:refs/heads/master *)",
      "Bash(git config --global *)",
      "Bash(git config --system *)",
      "Bash(touch *prod-read-window*)",
      "PowerShell(gh pr merge *)",
      "PowerShell(gh pr review *)",
      "PowerShell(gh repo *)",
      "PowerShell(gh auth *)",
      "PowerShell(gh api -X *)",
      "PowerShell(gh api * -X *)",
      "PowerShell(gh api --method *)",
      "PowerShell(gh api * --method *)",
      "PowerShell(gh api -f *)",
      "PowerShell(gh api * -f *)",
      "PowerShell(gh api -F *)",
      "PowerShell(gh api * -F *)",
      "PowerShell(gh api --field *)",
      "PowerShell(gh api * --field *)",
      "PowerShell(gh api --raw-field *)",
      "PowerShell(gh api * --raw-field *)",
      "PowerShell(gh api --input *)",
      "PowerShell(gh api * --input *)",
      "PowerShell(git push --force *)",
      "PowerShell(git push * --force)",
      "PowerShell(git push * --force *)",
      "PowerShell(git push -f *)",
      "PowerShell(git push * -f)",
      "PowerShell(git push * -f *)",
      "PowerShell(git push * main)",
      "PowerShell(git push * main *)",
      "PowerShell(git push *:main)",
      "PowerShell(git push *:main *)",
      "PowerShell(git push * master)",
      "PowerShell(git push * master *)",
      "PowerShell(git push *:master)",
      "PowerShell(git push *:master *)",
      "PowerShell(git push *:refs/heads/main)",
      "PowerShell(git push *:refs/heads/main *)",
      "PowerShell(git push *:refs/heads/master)",
      "PowerShell(git push *:refs/heads/master *)",
      "PowerShell(git config --global *)",
      "PowerShell(git config --system *)",
      "PowerShell(touch *prod-read-window*)",
      "PowerShell(New-Item *prod-read-window*)",
      "PowerShell(Set-Content *prod-read-window*)",
      "PowerShell(Add-Content *prod-read-window*)",
      "PowerShell(Out-File *prod-read-window*)",
      "PowerShell(Copy-Item *prod-read-window*)",
      "PowerShell(Move-Item *prod-read-window*)",
      "Read(~/.ssh/**)",
      "Read(~/.aws/**)",
      "Read(~/.azure/**)",
      "Read(~/.kube/**)",
      "Read(~/.oci/**)",
      "Read(//**/.env)",
      "Read(//**/.env.*)",
      "Read(//**/*.pem)",
      "Read(//**/id_rsa*)",
      "Read(//**/id_ed25519*)",
      "Edit(~/.claude/settings.json)",
      "Edit(~/.claude/settings.local.json)",
      "Edit(~/.claude/hooks/**)",
      "Edit(~/.claude/prod-read-window)",
      "Edit(//**/.claude/settings.json)",
      "Edit(//**/.claude/settings.local.json)"
    ],
    "ask": [
      "Bash(git commit *)",
      "Bash(git push *)",
      "Bash(git rebase *)",
      "Bash(git reset --hard *)",
      "Bash(git branch -D *)",
      "Bash(git tag *)",
      "Bash(git credential *)",
      "Bash(gh pr create *)",
      "Bash(gh pr edit *)",
      "Bash(gh pr comment *)",
      "Bash(gh pr ready *)",
      "Bash(gh api *)",
      "Bash(gh release create *)",
      "Bash(npm publish *)",
      "Bash(pip install *)",
      "Bash(npm install *)",
      "Bash(npx *)",
      "PowerShell(git commit *)",
      "PowerShell(git push *)",
      "PowerShell(git rebase *)",
      "PowerShell(git reset --hard *)",
      "PowerShell(git branch -D *)",
      "PowerShell(git tag *)",
      "PowerShell(git credential *)",
      "PowerShell(gh pr create *)",
      "PowerShell(gh pr edit *)",
      "PowerShell(gh pr comment *)",
      "PowerShell(gh pr ready *)",
      "PowerShell(gh api *)",
      "PowerShell(gh release create *)",
      "PowerShell(npm publish *)",
      "PowerShell(pip install *)",
      "PowerShell(npm install *)",
      "PowerShell(npx *)",
      "mcp__*__PowerShell",
      "mcp__*__device_bash",
      "mcp__*__start_process",
      "mcp__*__interact_with_process",
      "mcp__*__execute_command",
      "mcp__*__run_command"
    ],
    "allow": [
      "Bash(git status *)",
      "Bash(git log *)",
      "Bash(git diff *)",
      "Bash(git show *)",
      "Bash(git fetch *)",
      "Bash(git stash list *)",
      "Bash(gh pr checks *)",
      "Bash(gh pr view *)",
      "Bash(gh pr list *)",
      "Bash(gh run view *)",
      "Bash(gh run list *)",
      "Bash(python -m pytest *)",
      "Bash(pytest *)",
      "Bash(python -m unittest *)",
      "Bash(ruff *)",
      "Bash(rg *)",
      "Bash(gitleaks *)",
      "PowerShell(git status *)",
      "PowerShell(git log *)",
      "PowerShell(git diff *)",
